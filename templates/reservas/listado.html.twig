{% extends "base.html.twig" %}

{% block title %}Reservas de alojamiento — MisterPlan{% endblock %}
{% block nav_listado %}active{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Reservas de alojamiento</h1>
        <p class="page-subtitle">Listado y gestión en tiempo real</p>
    </div>
    <button type="button" class="btn btn-primary" id="btn-abrir-crear">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        Nueva reserva
    </button>
</div>

<!-- Filtros -->
<section class="card filter-card" aria-label="Filtros de reservas">
    <form id="form-filtros" class="filter-form" method="GET" action="/">
        <div class="filter-group">
            <label for="filtro-estado" class="form-label">Estado</label>
            <select id="filtro-estado" name="estado" class="form-control">
                <option value="">Todos los estados</option>
                {% for est in estados %}
                    <option value="{{ est.value }}" {% if filtros.estado == est.value %}selected{% endif %}>
                        {{ est.etiqueta() }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="filter-group">
            <label for="filtro-desde" class="form-label">Desde</label>
            <input type="date" id="filtro-desde" name="desde" value="{{ filtros.desde }}" class="form-control">
        </div>

        <div class="filter-group">
            <label for="filtro-hasta" class="form-label">Hasta</label>
            <input type="date" id="filtro-hasta" name="hasta" value="{{ filtros.hasta }}" class="form-control">
        </div>

        <div class="filter-group filter-group-grow">
            <label for="filtro-q" class="form-label">Huésped</label>
            <input type="search" id="filtro-q" name="q" value="{{ filtros.q }}" placeholder="Buscar por nombre..." class="form-control">
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-secondary" id="btn-filtrar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                Filtrar
            </button>
            <button type="button" class="btn btn-outline" id="btn-limpiar-filtros">Limpiar</button>
        </div>
    </form>
</section>

<!-- Indicador de carga de la tabla -->
<div id="table-loading-bar" class="loading-bar" hidden aria-hidden="true"></div>

<!-- Contenedor de la tabla -->
<div class="card table-card">
    <div class="table-responsive">
        <table class="data-table" id="tabla-reservas">
            <thead>
                <tr>
                    <th scope="col" style="width: 70px;">ID</th>
                    <th scope="col">Huésped</th>
                    <th scope="col">Alojamiento</th>
                    <th scope="col">Fechas</th>
                    <th scope="col" class="text-right">Importe</th>
                    <th scope="col" class="text-center" style="width: 130px;">Estado</th>
                    <th scope="col" class="text-right" style="width: 170px;">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbody-reservas">
                {% if reservas is empty %}
                    <tr class="empty-row">
                        <td colspan="7" class="text-center text-muted py-8">
                            No se encontraron reservas con los filtros aplicados.
                        </td>
                    </tr>
                {% else %}
                    {% for r in reservas %}
                        <tr id="fila-reserva-{{ r.id }}" data-id="{{ r.id }}" data-estado="{{ r.estado.value }}">
                            <td class="cell-id">#{{ r.id }}</td>
                            <td>
                                <div class="cell-primary font-medium">{{ r.nombreHuesped }}</div>
                                <div class="cell-secondary text-muted">{{ r.emailHuesped }}</div>
                            </td>
                            <td>{{ r.nombreAlojamiento }}</td>
                            <td>
                                <div>{{ r.fechaEntrada|date('d/m/Y') }} &rarr; {{ r.fechaSalida|date('d/m/Y') }}</div>
                                <span class="text-muted small">{{ r.noches() }} noche{% if r.noches() != 1 %}s{% endif %}</span>
                            </td>
                            <td class="text-right font-medium">
                                {{ r.importe|number_format(2, ',', '.') }} &euro;
                            </td>
                            <td class="text-center cell-badge">
                                {% include "_partials/badge_estado.html.twig" with { estado: r.estado } %}
                            </td>
                            <td class="text-right cell-actions">
                                <a href="/reservas/{{ r.id }}" class="btn btn-xs btn-outline" title="Ver detalle">Detalle</a>
                                {% if r.puedeCancelarse() %}
                                    <button type="button"
                                            class="btn btn-xs btn-danger-outline btn-cancelar"
                                            data-id="{{ r.id }}"
                                            data-nombre="{{ r.nombreHuesped }}">
                                        Cancelar
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <div class="pagination-bar" id="pagination-bar">
        <span class="pagination-info" id="pagination-info">
            Mostrando {{ reservas|length }} de <strong id="total-count">{{ meta.total }}</strong> reservas
        </span>
        {% if meta.total_paginas > 1 %}
            <div class="pagination-pages" id="pagination-pages">
                {% for p in 1..meta.total_paginas %}
                    <a href="?pagina={{ p }}{% if filtros.estado %}&estado={{ filtros.estado }}{% endif %}{% if filtros.desde %}&desde={{ filtros.desde }}{% endif %}{% if filtros.hasta %}&hasta={{ filtros.hasta }}{% endif %}{% if filtros.q %}&q={{ filtros.q }}{% endif %}"
                       class="page-link {% if p == meta.pagina %}active{% endif %}"
                       data-page="{{ p }}">
                        {{ p }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<!-- Modal: Crear Reserva -->
<div class="modal-backdrop" id="modal-crear" hidden role="dialog" aria-modal="true" aria-labelledby="modal-crear-title">
    <div class="modal-card">
        <div class="modal-header">
            <h2 id="modal-crear-title" class="modal-title">Nueva reserva</h2>
            <button type="button" class="btn-close" id="btn-cerrar-modal" aria-label="Cerrar">&times;</button>
        </div>

        <form id="form-crear-reserva" novalidate>
            <div class="modal-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label for="crear-nombre" class="form-label">Nombre del huésped <span class="req">*</span></label>
                        <input type="text" id="crear-nombre" name="nombre_huesped" class="form-control" required maxlength="120" placeholder="Ej. Lucía Gómez">
                        <span class="field-error" data-error-for="nombre_huesped"></span>
                    </div>

                    <div class="form-field">
                        <label for="crear-email" class="form-label">Email <span class="req">*</span></label>
                        <input type="email" id="crear-email" name="email_huesped" class="form-control" required maxlength="254" placeholder="lucia@example.com">
                        <span class="field-error" data-error-for="email_huesped"></span>
                    </div>

                    <div class="form-field full-width">
                        <label for="crear-alojamiento" class="form-label">Alojamiento <span class="req">*</span></label>
                        <input type="text" id="crear-alojamiento" name="nombre_alojamiento" class="form-control" required maxlength="150" placeholder="Ej. Hotel Gran Vía">
                        <span class="field-error" data-error-for="nombre_alojamiento"></span>
                    </div>

                    <div class="form-field">
                        <label for="crear-entrada" class="form-label">Fecha de entrada <span class="req">*</span></label>
                        <input type="date" id="crear-entrada" name="fecha_entrada" class="form-control" required>
                        <span class="field-error" data-error-for="fecha_entrada"></span>
                    </div>

                    <div class="form-field">
                        <label for="crear-salida" class="form-label">Fecha de salida <span class="req">*</span></label>
                        <input type="date" id="crear-salida" name="fecha_salida" class="form-control" required>
                        <span class="field-error" data-error-for="fecha_salida"></span>
                    </div>

                    <div class="form-field">
                        <label for="crear-importe" class="form-label">Importe (&euro;) <span class="req">*</span></label>
                        <input type="number" id="crear-importe" name="importe" class="form-control" required step="0.01" min="0.01" placeholder="150.00">
                        <span class="field-error" data-error-for="importe"></span>
                    </div>

                    <div class="form-field full-width">
                        <label for="crear-notas" class="form-label">Notas adicionales</label>
                        <textarea id="crear-notas" name="notas" class="form-control" rows="2" maxlength="1000" placeholder="Peticiones especiales, hora de llegada..."></textarea>
                        <span class="field-error" data-error-for="notas"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline" id="btn-cancelar-modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btn-guardar-reserva">
                    <span class="btn-text">Guardar reserva</span>
                    <span class="spinner" hidden aria-hidden="true"></span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Confirmar Cancelación -->
<div class="modal-backdrop" id="modal-confirmar-cancelar" hidden role="dialog" aria-modal="true" aria-labelledby="modal-cancel-title">
    <div class="modal-card modal-sm">
        <div class="modal-header">
            <h2 id="modal-cancel-title" class="modal-title">Cancelar reserva</h2>
            <button type="button" class="btn-close" id="btn-cerrar-cancelar" aria-label="Cerrar">&times;</button>
        </div>
        <div class="modal-body">
            <p>¿Estás seguro/a de que deseas cancelar la reserva <strong id="cancel-reserva-info"></strong>?</p>
            <p class="text-muted small">Esta acción no se puede deshacer.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" id="btn-abortar-cancelar">No, mantener</button>
            <button type="button" class="btn btn-danger" id="btn-ejecutar-cancelar">
                <span class="btn-text">Sí, cancelar reserva</span>
                <span class="spinner" hidden aria-hidden="true"></span>
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="/assets/js/listado.js" type="module"></script>
{% endblock %}
